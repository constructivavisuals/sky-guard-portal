# Dveřník před go2rtc.
#
# ═══ NEVLASTNÍ porty 80 a 443 ══════════════════════════════════════
# Na VPS je má Caddy Constructivy (/opt/cam-relay), který obsluhuje
# cam.constructiva.cz. Dva Caddy o tytéž porty soupeřit nemůžou, takže
# tenhle poslouchá jen uvnitř sítě kontejnerů a veřejnou adresu mu
# předává ten první.
#
# Rozdělení práce je schválně takhle, a ne obráceně:
#
#   Caddy Constructivy   TLS, certifikát, jeden blok „pošli to dál“
#   tenhle Caddy         KDO SMÍ a KAM — allowlist cest a lístky
#
# Bezpečnostní rozhodnutí tím zůstávají v tomhle repozitáři. Kdyby
# allowlist bydlel v konfiguraci Constructivy, měnil by se v repozitáři,
# který o Sky Guardu nic neví — a při jeho příštím nasazení by se změna
# ztratila, aniž by to někdo poznal.
#
# ═══ Administrace go2rtc NESMÍ ven ═════════════════════════════════
# go2rtc má na `/` webové rozhraní, kterým jde přidat proud
# z LIBOVOLNÉ adresy — tedy i z vnitřní sítě stavby. Proto se sem
# nepouští cesty, jen ty tři, které přehrávač potřebuje. Výchozí je
# odmítnutí, ne propuštění: kdyby se seznam někdy rozšiřoval, chyba
# bude v tom, že něco nejde, ne v tom, že jde všechno.
#
# ═══ Kdyby Sky Guard někdy dostal vlastní stroj ════════════════════
# Pak se `:80` níž vymění za `{$LIVE_HOSTNAME}`, v compose se vrátí
# publikované porty 80 a 443 a svazky na certifikáty. Caddy si o
# certifikát požádá sám. Nic jiného se měnit nemusí.

{
	# Za cizím proxy je vzdálená adresa jeho, ne divákova. Bez tohohle
	# by v logu byla u každého požadavku adresa souseda z docker sítě.
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	# Jen to, co potřebuje přehrávač v portálu.
	#
	#   /api/ws         obraz (MSE po websocketu)
	#   /api/webrtc     kdyby se někdy přešlo na WebRTC
	#   /api/frame.jpeg náhled jednoho snímku
	@proud path /api/ws /api/webrtc /api/frame.jpeg

	handle @proud {
		# Lístek ověřuje sky-live. Odpověď 200 pustí, cokoli jiného ne.
		# Adresa i s parametry mu jde v X-Forwarded-Uri.
		forward_auth sky-live:8089 {
			uri /auth
		}

		reverse_proxy go2rtc:1984 {
			# ═══ Přepis Origin ═════════════════════════════════
			# Portál běží na JINÉ doméně než stream, takže je to pro
			# prohlížeč požadavek přes původy. go2rtc má na websocketu
			# standardní kontrolu, která porovnává Origin s Host, a ta
			# takový požadavek odmítne:
			#
			#   websocket: request origin not allowed by
			#   Upgrader.CheckOrigin
			#
			# Origin se proto přepíše na vlastní hostitele. `{host}` je
			# ten, na který přišel požadavek, takže to platí i pro
			# náhledová nasazení portálu na měnících se adresách
			# — ta by se do pevného seznamu nedala vypsat.
			#
			# ═══ Proč to nedělá díru ═══════════════════════════
			# O přístupu tu nerozhoduje Origin, ale LÍSTEK, a ten cizí
			# stránka nezíská: vydává ho portál proti přihlášení a
			# odpověď si přes původy nepřečte. Kontrola původu by tedy
			# nebránila ničemu, co by lístek nezastavil dřív.
			#
			# Alternativa je `api: origin: "*"` v go2rtc.yaml, jak to
			# má Constructiva. Tady je to radši v Caddy: rozhodnutí
			# o přístupu tím zůstávají v jednom souboru a go2rtc si
			# přísnou kontrolu ponechá pro případ, že by na něj někdo
			# sáhl zevnitř sítě mimo tenhle dveřník.
			header_up Origin http://{host}
		}
	}

	# Hlídači zvenčí, ať se pozná živá služba od zaseklé.
	handle /zdravi {
		reverse_proxy sky-live:8089
	}

	# Všechno ostatní včetně administrace go2rtc.
	handle {
		respond "not found" 404
	}

	log {
		output stdout
		format console
	}
}
