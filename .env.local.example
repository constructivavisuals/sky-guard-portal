# ------------------------------------------------------------
# Sky Guard Portal — vzor konfigurace
# Zkopíruj do .env.local a doplň skutečné hodnoty.
# ------------------------------------------------------------

# --- Supabase (region EU) ---
NEXT_PUBLIC_SUPABASE_URL=https://ateldjcffovdiexzmkii.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=ateldjcffovdiexzmkii

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_URL=

# --- Ingest z kamer ---
# Sdílený secret pro HMAC-SHA256 podpis (hlavička X-Signature).
# Podepisuje se řetězec "<X-Timestamp>.<raw body>". Generuj náhodně:
#   openssl rand -hex 32
INGEST_SECRET=

# --- DJI FlightHub 2 ---
FH_HOST=
FH_PROJECT_UUID=
FH_WORKFLOW_UUID=
FH_CREATOR=
FH_USER_TOKEN=
